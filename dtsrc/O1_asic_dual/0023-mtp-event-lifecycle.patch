+void MtpFfsHandle::eventLoop() {
+    for (;;) {
+        std::vector<unsigned char> packet;
+        {
+            std::lock_guard<std::mutex> lock(mEventMutex);
+            if (mEventStopping) return;
+            if (!mEventQueue.empty()) {
+                packet = std::move(mEventQueue.front());
+                mEventQueue.pop_front();
+            }
+        }
+        if (packet.empty()) {
