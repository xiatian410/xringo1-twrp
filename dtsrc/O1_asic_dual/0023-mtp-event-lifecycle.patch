+bool MtpFfsHandle::sendEventRequest(const std::vector<unsigned char>& packet) {
+    struct iocb request{};
+    io_prep(&request, mIntr, packet.data(), packet.size(), 0, false);
+    request.aio_flags = IOCB_FLAG_RESFD;
+    request.aio_resfd = mIntrWake;
+    struct iocb* requests[] = {&request};
+    bool submitted = false;
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+    int error = 0;
+    while (!error) {
+        {
+            std::lock_guard<std::mutex> lock(mEventMutex);
+            if (mEventStopping) { error = ESHUTDOWN; break; }
+        }
+        if (std::chrono::steady_clock::now() >= deadline) { error = ETIMEDOUT; break; }
+        if (!submitted) {
+            int ret = io_submit(mIntrCtx, 1, requests);
+            if (ret == 1) submitted = true;
+            else if (ret < 0 && errno != EINTR && errno != EAGAIN) {
+                error = errno;
+                break;
+            }
+        }
+        if (submitted) {
+            struct io_event completed{};
+            struct timespec zero{};
+            int ret = io_getevents(mIntrCtx, 0, 1, &completed, &zero);
+            if (ret == 1) {
+                // A short USB event is a broken container. Do not replay it or
+                // submit a separate tail packet, which would corrupt framing.
+                if (completed.res == static_cast<int64_t>(packet.size()) && !completed.res2)
