+        int ret = poll(&wake, 1, 20);
+        if (ret < 0 && errno != EINTR) { error = errno; break; }
+        if (ret > 0) { uint64_t count; TEMP_FAILURE_RETRY(::read(mIntrWake, &count, sizeof(count))); }
+    }
+    if (submitted) {
