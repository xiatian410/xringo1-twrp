+                    // endpoint error in its completion instead of io_submit.
+                    // Drain that completion's wake before the retry delay.
+                    submitted = false;
+                    uint64_t count;
+                    TEMP_FAILURE_RETRY(::read(mIntrWake, &count, sizeof(count)));
+                } else {
