diff --git a/data.cpp b/data.cpp
index ee6bd58..23e68e7 100644
--- a/data.cpp
+++ b/data.cpp
@@ -24,6 +24,7 @@
 #include <ctime>
 #include <filesystem>
 #include <format>
+#include <mutex>
 #include <optional>
 #include <string>
 #include <system_error>
@@ -873,14 +874,20 @@ int DataManager::GetMagicValue(const std::string& key, std::string& value) {
     return 0;
   }
   if (key == "tw_cpu_temp") {
+    value.clear();
     int tw_no_cpu_temp;
     GetValue("tw_no_cpu_temp", tw_no_cpu_temp);
     if (tw_no_cpu_temp == 1) return -1;
 
     // Cached for 5s; steady_clock is monotonic, so wall-clock changes can't stall it.
+    static std::mutex temperature_lock;
+    const std::lock_guard<std::mutex> guard(temperature_lock);
     static std::chrono::steady_clock::time_point next_refresh{};
-    static uint64_t convert_temp = 0;
-    if (const auto now = std::chrono::steady_clock::now(); now > next_refresh) {
+    static int64_t convert_temp = 0;
+    static bool valid = false;
+    if (const auto now = std::chrono::steady_clock::now(); now >= next_refresh) {
+      next_refresh = now + std::chrono::seconds(5);
+      valid = false;
 #ifdef TW_CUSTOM_CPU_TEMP_PATH
       const std::string cpu_temp_file = TW_CUSTOM_CPU_TEMP_PATH;
 #else
@@ -888,15 +895,28 @@ int DataManager::GetMagicValue(const std::string& key, std::string& value) {
 #endif
       std::string result;
       if (!android::base::ReadFileToString(cpu_temp_file, &result)) return -1;
-      // std::from_chars partial-parses past the trailing newline sysfs appends, so
-      // no Trim is needed; on garbage raw stays 0, like the old strtoul.
-      uint64_t raw = 0;
-      std::from_chars(result.data(), result.data() + result.size(), raw);
-      convert_temp = raw / 1000;
-      if (convert_temp == 0) convert_temp = raw;
-      if (convert_temp >= 150) convert_temp = raw / 10;
-      next_refresh = now + std::chrono::seconds(5);
+      const auto first = result.find_first_not_of(" \t\r\n");
+      if (first == std::string::npos) return -1;
+      const auto last = result.find_last_not_of(" \t\r\n") + 1;
+      int64_t raw = 0;
+      const auto [end, error] = std::from_chars(result.data() + first, result.data() + last, raw);
+      if (error != std::errc{} || end != result.data() + last) return -1;
+      if (cpu_temp_file.starts_with("/sys/class/thermal/")) {
+        // Linux thermal-class temp is signed millidegrees Celsius, including
+        // sub-degree and negative readings. Magnitude must not select its unit.
+        if (raw < -273150 || raw > 1000000) return -1;
+        convert_temp = raw / 1000;
+      } else {
+        // Retain the legacy convention for explicitly configured non-thermal
+        // nodes. dijun uses the standard thermal class path above.
+        if (raw < -273150 || raw > 1000000) return -1;
+        convert_temp = raw / 1000;
+        if (convert_temp == 0) convert_temp = raw;
+        if (convert_temp >= 150 || convert_temp <= -150) convert_temp = raw / 10;
+      }
+      valid = true;
     }
+    if (!valid) return -1;
     value = std::to_string(convert_temp);
     return 0;
   }
diff --git a/gui2/backend/status_backend.cpp b/gui2/backend/status_backend.cpp
