+static int
+tar_restore_android_xattrs(TAR *t, const char *filename)
+{
+	if (!(t->options & TAR_STORE_ANDROID_USER_XATTR))
+		return 0;
+	if (t->th_buf.has_user_default &&
+	    setxattr(filename, "user.default", NULL, 0, 0) < 0)
+		return -1;
+	if (t->th_buf.has_user_cache &&
+	    write_path_inode(filename, "cache", "user.inode_cache") != 0)
+		return -1;
+	if (t->th_buf.has_user_code_cache &&
+	    write_path_inode(filename, "code_cache", "user.inode_code_cache") != 0)
+		return -1;
+	return 0;
+}
 
