+/* Extended records contain binary capabilities/policies, so neither strlen()
+ * nor strstr() can delimit them. Honor the PAX byte count for each record. */
+static int
+th_read_extended(TAR *t, const char *buf, size_t size)
+{
+	size_t offset = 0;
+	while (offset < size) {
+		size_t count = 0, digits = 0, remaining = size - offset;
+		const char *record = buf + offset;
+		while (digits < remaining && record[digits] >= '0' && record[digits] <= '9') {
+			unsigned digit = record[digits++] - '0';
+			if (count > (T_BLOCKSIZE - digit) / 10)
+				goto invalid;
+			count = count * 10 + digit;
+		}
+		if (digits == 0 || digits >= remaining || record[digits] != ' ' ||
+		    count < digits + 2 || count > remaining || record[count - 1] != '\n')
+			goto invalid;
+		const char *value = record + digits + 1;
+		size_t length = count - digits - 2;
+		if (length >= SELINUX_TAG_LEN && !memcmp(value, SELINUX_TAG, SELINUX_TAG_LEN)) {
+			value += SELINUX_TAG_LEN;
+			length -= SELINUX_TAG_LEN;
+			if (memchr(value, '\0', length) != NULL)
+				goto invalid;
+			char *context = strndup(value, length);
+			if (context == NULL)
+				return -1;
+			free(t->th_buf.selinux_context);
+			t->th_buf.selinux_context = context;
+		} else if (length >= CAPABILITIES_TAG_LEN && !memcmp(value, CAPABILITIES_TAG, CAPABILITIES_TAG_LEN)) {
+			if (length != CAPABILITIES_TAG_LEN + sizeof(t->th_buf.cap_data))
+				goto invalid;
+			memcpy(&t->th_buf.cap_data, value + CAPABILITIES_TAG_LEN, sizeof(t->th_buf.cap_data));
+			t->th_buf.has_cap_data = 1;
+#ifdef USE_FSCRYPT
+		} else if (length >= FSCRYPT_TAG_LEN && !memcmp(value, FSCRYPT_TAG, FSCRYPT_TAG_LEN)) {
+			if (length != FSCRYPT_TAG_LEN + 1 + sizeof(*t->th_buf.fep) || value[FSCRYPT_TAG_LEN] != '0')
+				goto invalid;
+			if (t->th_buf.fep == NULL)
+				t->th_buf.fep = malloc(sizeof(*t->th_buf.fep));
+			if (t->th_buf.fep == NULL)
+				return -1;
+			memcpy(t->th_buf.fep, value + FSCRYPT_TAG_LEN + 1, sizeof(*t->th_buf.fep));
+#endif
+		} else if (length == ANDROID_USER_DEFAULT_TAG_LEN && !memcmp(value, ANDROID_USER_DEFAULT_TAG, length)) {
+			t->th_buf.has_user_default = 1;
+		} else if (length == ANDROID_USER_CACHE_TAG_LEN && !memcmp(value, ANDROID_USER_CACHE_TAG, length)) {
+			t->th_buf.has_user_cache = 1;
+		} else if (length == ANDROID_USER_CODE_CACHE_TAG_LEN && !memcmp(value, ANDROID_USER_CODE_CACHE_TAG, length)) {
+			t->th_buf.has_user_code_cache = 1;
+		}
+		offset += count;
+	}
+	return 0;
+invalid:
+	errno = EINVAL;
+	LOG("Invalid extended tar metadata record\n");
+	return -1;
+}
 
