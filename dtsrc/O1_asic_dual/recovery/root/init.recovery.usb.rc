# XRing recovery uses configfs and FunctionFS, matching the stock USB controller.
# The checked helper owns transitions for this device, including ADB recovery.
on init
    setprop sys.recovery.usb.managed 1
    setprop sys.usb.controller e1ac0000.dwc3
    setprop vendor.usb.use_ffs_mtp 1

on fs && property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/ffs.mtp 0770 system usb
    write /config/usb_gadget/g1/functions/ffs.mtp/os_desc/interface.MTP/compatible_id MTP
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign MSFT100
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1024,gid=1024,no_disconnect=1

# Read the current request on every action. Queued property events can be stale.
on fs && property:sys.usb.configfs=1 && property:sys.recovery.usb.managed=1
    exec u:r:dijun_usb:s0 root shell usb -- /system/bin/dijun-usb-config

on property:sys.usb.config=* && property:sys.usb.configfs=1 && property:sys.recovery.usb.managed=1
    exec u:r:dijun_usb:s0 root shell usb -- /system/bin/dijun-usb-config

on property:sys.usb.ffs.ready=* && property:sys.usb.configfs=1 && property:sys.recovery.usb.managed=1
    exec u:r:dijun_usb:s0 root shell usb -- /system/bin/dijun-usb-config

on property:sys.usb.ffs.mtp.ready=* && property:sys.usb.configfs=1 && property:sys.recovery.usb.managed=1
    exec u:r:dijun_usb:s0 root shell usb -- /system/bin/dijun-usb-config

on property:init.svc.adbd=* && property:sys.usb.configfs=1 && property:sys.recovery.usb.managed=1
    exec u:r:dijun_usb:s0 root shell usb -- /system/bin/dijun-usb-config

on property:init.svc.fastbootd=* && property:sys.usb.configfs=1 && property:sys.recovery.usb.managed=1
    exec u:r:dijun_usb:s0 root shell usb -- /system/bin/dijun-usb-config

