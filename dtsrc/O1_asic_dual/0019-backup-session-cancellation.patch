+// One backup worker owns Fork/ReadProgress/Wait. Cancel may run concurrently.
+// Keep the leader unreaped until all group signals have been sent: its PID and
+// process-group ID cannot be recycled while cancellation holds this mutex.
+class BackupProcess {
+ public:
+  pid_t Fork(const std::atomic_bool& cancelled) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    if (pid_ != 0 || cancelled.load()) {
+      errno = cancelled.load() ? ECANCELED : EBUSY;
+      return -1;
+    }
+    const pid_t child = fork();
+    if (child == 0) {
+      // The inherited mutex is never used by the child. Do not unlock a mutex
+      // copied from a multithreaded parent; all child paths terminate via _exit.
+      lock.release();
+      if (setpgid(0, 0) != 0) _exit(125);
+      return 0;
+    }
+    if (child < 0) return -1;
+    if (setpgid(child, child) != 0) {
+      const int error = errno;
+      kill(child, SIGKILL);
+      while (waitpid(child, nullptr, 0) < 0 && errno == EINTR) {}
+      errno = error;
+      return -1;
+    }
+    pid_ = child;
+    return child;
+  }
+
+  void Cancel(std::atomic_bool& cancelled) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    cancelled.store(true);
+    if (pid_ > 1) kill(-pid_, SIGKILL);
+  }
+
+  void Terminate() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (pid_ > 1) kill(-pid_, SIGKILL);
+  }
+
+  // A compressor/encryptor may still hold a pipe after the leader fails. Poll
+  // also checks that leader and closes its whole private group on exit.
+  // 1 = complete record, 0 = clean EOF, -1 = truncated record or I/O error.
+  int ReadProgress(int fd, uint64_t& value) {
+    size_t used = 0;
+    while (used != sizeof(value)) {
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        siginfo_t info{};
+        if (pid_ > 1 && waitid(P_PID, pid_, &info, WEXITED | WNOHANG | WNOWAIT) == 0 &&
+            info.si_pid == pid_) kill(-pid_, SIGKILL);
+      }
+      pollfd pfd{fd, POLLIN, 0};
+      const int ready = poll(&pfd, 1, 100);
+      if (ready < 0 && errno == EINTR) continue;
+      if (ready < 0 || (ready > 0 && (pfd.revents & POLLNVAL))) return -1;
+      if (ready == 0) continue;
+      const ssize_t count = read(fd, reinterpret_cast<char*>(&value) + used, sizeof(value) - used);
+      if (count < 0 && errno == EINTR) continue;
+      if (count < 0) return -1;
+      if (count == 0) return used == 0 ? 0 : -1;
+      used += count;
+    }
+    return 1;
+  }
+
+  int Wait() {
+    for (;;) {
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (pid_ <= 1) return -1;
+        siginfo_t info{};
+        const int result = waitid(P_PID, pid_, &info, WEXITED | WNOHANG | WNOWAIT);
+        if (result < 0 && errno != EINTR) {
+          // ECHILD is a failure, never successful completion or permission to
+          // send a signal to a numeric PID that we no longer own.
+          pid_ = 0;
+          return -1;
+        }
+        if (result == 0 && info.si_pid == pid_) {
+          kill(-pid_, SIGKILL);
+          int status = 0;
+          pid_t reaped;
+          do { reaped = waitpid(pid_, &status, 0); } while (reaped < 0 && errno == EINTR);
+          pid_ = 0;
+          return reaped > 0 && WIFEXITED(status) && WEXITSTATUS(status) == 0 ? 0 : -1;
+        }
+      }
+      usleep(10000);
+    }
+  }
+
+ private:
+  std::mutex mutex_;
+  pid_t pid_ = 0;
+};
