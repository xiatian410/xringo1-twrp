 using namespace std;
 
+namespace {
+// A codec pipe may return less than one tar block without reaching EOF.
+// libtar requires a complete requested block, or a genuine EOF/error.
+ssize_t readArchive(int fd, void* buffer, size_t size) {
+	size_t total = 0;
+	while (total < size) {
+		const ssize_t count = read(fd, static_cast<char*>(buffer) + total, size - total);
+		if (count < 0 && errno == EINTR) continue;
+		if (count < 0) return -1;
+		if (count == 0) break;
+		total += count;
+	}
+	return static_cast<ssize_t>(total);
+}
+
+// AES runs in-process after fork, so O_CLOEXEC alone cannot release inherited
+// pipe ends. Other archive threads may own those ends; keep only stdio here.
+bool prepareCodecChild(int input, int output) {
+	if (dup2(input, STDIN_FILENO) < 0 || dup2(output, STDOUT_FILENO) < 0) return false;
+#ifdef __NR_close_range
+	if (syscall(__NR_close_range, 3U, ~0U, 0U) == 0) return true;
+#endif
+	struct rlimit limit{};
+	if (getrlimit(RLIMIT_NOFILE, &limit) != 0 || limit.rlim_cur == RLIM_INFINITY) return false;
+	for (rlim_t fd = 3; fd < limit.rlim_cur; ++fd) close(static_cast<int>(fd));
+	return true;
+}
+
+bool waitCodec(pid_t& pid, bool stop) {
+	if (pid <= 0) { pid = 0; return true; }
+	if (stop) kill(pid, SIGKILL);
+	int status = 0;
+	const int result = TWFunc::WaitForChild(pid, &status, "archive codec");
+	pid = 0;
+	return result == 0;
+}
