+std::optional<std::vector<std::string>> TwrpDigestDriver::GetBackupFiles(const std::string& filename) {
+  namespace fs = std::filesystem;
+  const fs::path base(filename);
+  const auto folder = base.has_parent_path() ? base.parent_path() : fs::path(".");
+  const std::string prefix = base.filename().string();
+  std::error_code ec;
+  fs::directory_iterator it(folder, ec), end;
+  if (ec) {
+    LOGERR("Restore preflight: cannot read backup directory '%s'\n", folder.c_str());
+    return std::nullopt;
+  }
+  bool single = false;
+  std::map<int, std::string> split;
+  for (; it != end; it.increment(ec)) {
+    if (ec) break;
+    const std::string name = it->path().filename().string();
+    if (!name.starts_with(prefix)) continue;
+    const std::string suffix = name.substr(prefix.size());
+    const bool numbered = !suffix.empty() && std::ranges::all_of(suffix, [](char c) {
+      return c >= '0' && c <= '9';
+    });
+    if (!suffix.empty() && !numbered) continue;  // sidecars are not archive parts
+    if (numbered && (suffix.size() != 3 || suffix[0] > '8')) {
+      LOGERR("Restore preflight: unsupported split archive name '%s'\n", name.c_str());
+      return std::nullopt;
+    }
+    const auto type = it->symlink_status(ec);
+    if (ec || !fs::is_regular_file(type)) {
+      LOGERR("Restore preflight: backup is not a regular file '%s'\n", name.c_str());
+      return std::nullopt;
+    }
+    const auto size = it->file_size(ec);
+    if (ec || size == 0) {
+      LOGERR("Restore preflight: empty or unreadable backup '%s'\n", name.c_str());
+      return std::nullopt;
+    }
+    if (!numbered) single = true;
+    else split.emplace((suffix[0]-'0')*100+(suffix[1]-'0')*10+suffix[2]-'0', it->path().string());
+  }
+  if (ec) return std::nullopt;
+  if (single && split.empty()) return std::vector<std::string>{filename};
+  if (single || !split.contains(0)) {
+    LOGERR("Restore preflight: missing or ambiguous backup '%s'\n", filename.c_str());
+    return std::nullopt;
+  }
+  std::vector<std::string> files;
+  for (const auto& [index, path] : split) {
+    // Groups can be absent, but extractMulti stops at a gap inside a group.
+    if (index % 100 != 0 && !split.contains(index - 1)) {
+      LOGERR("Restore preflight: gap before split archive '%s'\n", path.c_str());
+      return std::nullopt;
+    }
+    files.push_back(path);
+  }
+  return files;
+}
