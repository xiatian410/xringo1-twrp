+int TwrpMtpStorage::ReconcileDirectory(MtpEntry* dir, std::vector<PendingEvent>& events) {
+    const auto path = fs::path(GetNodePath(dir));
+    std::error_code ec;
+    const auto status = fs::symlink_status(path, ec);
+    std::map<std::string, bool> observed;
+    if (!ec && fs::is_directory(status)) {
+        fs::directory_iterator iterator(path, ec), end;
+        while (!ec && iterator != end) {
+            const auto child_status = iterator->symlink_status(ec);
+            if (ec) break;
+            if (fs::is_directory(child_status) || fs::is_regular_file(child_status))
+                observed.emplace(iterator->path().filename().string(), fs::is_directory(child_status));
+            iterator.increment(ec);
+        }
+        if (ec) return -1; // Never erase a tree after a partial failed enumeration.
+    } else if (ec && ec.value() != ENOENT) {
+        return -1;
+    }
+    std::vector<MtpObjectHandle> remove;
+    for (auto& [handle, child] : dir->children) {
+        auto found = observed.find(child->name);
+        if (handle != handle_currently_sending_ &&
+            (found == observed.end() || found->second != child->is_dir)) remove.push_back(handle);
+    }
+    for (auto handle : remove) {
+        std::vector<MtpObjectHandle> gone;
+        CollectSubtreeHandles(FindNode(handle), gone);
+        DeleteFile(handle);
+        for (auto id : gone) events.push_back({MTP_EVENT_OBJECT_REMOVED, id});
+    }
+    for (auto [name, is_dir] : observed) {
+        auto* entry = FindEntryByName(dir, name);
+        const bool added = entry == nullptr;
+        if (added) entry = AddNewNode(is_dir, dir, name);
+        if (entry->handle == handle_currently_sending_) continue;
+        const auto before = entry->properties;
+        AddProperties(entry, path / name, getStorageID());
+        if (added || before != entry->properties)
+            events.push_back({static_cast<MtpEventCode>(added ? MTP_EVENT_OBJECT_ADDED : MTP_EVENT_OBJECT_INFO_CHANGED), entry->handle});
+        if (is_dir && entry->already_read) ReconcileDirectory(entry, events);
+    }
+    dir->already_read = !ec && fs::is_directory(status);
+    if (dir->already_read) AddInotify(dir);
+    return dir->already_read ? 0 : -1;
+}
+
+bool TwrpMtpStorage::RescanObject(MtpObjectHandle handle, const char* path) {
+    std::vector<PendingEvent> events;
