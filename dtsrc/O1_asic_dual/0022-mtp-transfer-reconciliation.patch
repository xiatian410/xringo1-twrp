+        if (ec || (entry->is_dir ? !fs::is_directory(source_type) : !fs::is_regular_file(source_type)))
+            return MTP_RESPONSE_INVALID_OBJECT_HANDLE;
+        const auto target_type = fs::symlink_status(target_path, ec);
+        if ((!ec && target_type.type() != fs::file_type::not_found) || (ec && ec.value() != ENOENT))
+            return MTP_RESPONSE_ACCESS_DENIED;
+        if (FindEntryByName(target_parent, entry->name)) return MTP_RESPONSE_ACCESS_DENIED;
