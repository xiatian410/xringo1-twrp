+/* Read exactly the size recorded in the header. A shrinking file must fail
+ * instead of archiving uninitialized/stale bytes in its final block. */
+static int
+append_read_exact(int fd, char *block, size_t size)
+{
+	size_t done = 0;
+	while (done < size)
+	{
+		ssize_t count = read(fd, block + done, size - done);
+		if (count < 0)
+		{
+			if (errno == EINTR)
+				continue;
+			return -1;
+		}
+		if (count == 0)
+		{
+			errno = EIO;
+			return -1;
+		}
+		done += count;
+	}
+	return 0;
+}
