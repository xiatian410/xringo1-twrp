+bool TWPartitionManager::IsMtpEnabled() const {
+#ifdef TW_HAS_MTP
+  // GUI readers must not wait for a startup/shutdown holding this lock.
+  std::unique_lock<std::recursive_mutex> lock(mtp_mutex_, std::try_to_lock);
+  if (!lock.owns_lock() || mtp_pid_ <= 1 || mtp_write_fd < 0) return false;
+  siginfo_t info{};
+  int result;
+  do { result = waitid(P_PID, mtp_pid_, &info, WEXITED | WNOHANG | WNOWAIT); }
+  while (result < 0 && errno == EINTR);
+  return result == 0 && info.si_pid == 0 &&
+      android::base::GetProperty("sys.usb.config", "") == "mtp,adb" &&
+      android::base::GetProperty("sys.usb.state", "") == "mtp,adb" &&
+      (android::base::GetProperty("sys.usb.configfs", "0") != "1" ||
+       android::base::GetProperty("sys.usb.ffs.mtp.ready", "") == "1");
+#else
+  return false;
+#endif
+}
