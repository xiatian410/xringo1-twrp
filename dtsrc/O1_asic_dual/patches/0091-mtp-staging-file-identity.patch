+bool TwrpMtpStorage::IsSendObjectFile(const std::string& path) {
+    // Called under tree_mutex_ by all three observer/enumeration paths.
+    for (const auto& [handle, file] : sending_files_) {
+        if (file.path == path) return true;
+    }
+    auto it = abandoned_sending_files_.find(path);
+    if (it == abandoned_sending_files_.end()) return false;
+    struct stat st{};
+    if (lstat(path.c_str(), &st) != 0) {
+        if (errno != ENOENT && errno != ENOTDIR) return true;
+    } else if (S_ISREG(st.st_mode) && st.st_dev == it->second.device &&
+               st.st_ino == it->second.inode &&
+               (!it->second.changed_known ||
+                (st.st_ctim.tv_sec == it->second.changed.tv_sec &&
+                 st.st_ctim.tv_nsec == it->second.changed.tv_nsec))) {
+        return true;
+    }
+    // Removed, replaced or externally modified: release the stale record.
+    // This is visibility bookkeeping only, never permission to delete a path.
+    abandoned_sending_files_.erase(it);
+    return false;
+}
