 int main(int argc, char **argv) {
 	int read_fd, write_fd, index;
-	char command[1024], result[512];
+	char command[1024] = {}, result[512];
 
 	if (argc < 2 || strcmp(argv[1], "help") == 0 || strcmp(argv[1], "--help") == 0 || strcmp(argv[1], "?") == 0 || strcmp(argv[1], "-h") == 0) {
 		print_usage();
@@ -129,9 +129,20 @@
 		return do_getcap(argv[2]);
