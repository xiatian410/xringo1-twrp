-	sprintf(command, "%s", argv[1]);
-	for (index = 2; index < argc; index++) {
-		sprintf(command, "%s %s", command, argv[index]);
+	// Preserve the fixed-size wire record, including its NUL terminator. Check
+	// every argument before touching either FIFO; never send a truncated command.
+	size_t used = 0;
+	for (index = 1; index < argc; index++) {
+		const size_t length = strlen(argv[index]);
+		const size_t separator = index > 1 ? 1 : 0;
+		if (separator > sizeof(command) - 1 - used ||
+		    length > sizeof(command) - 1 - used - separator) {
+			fprintf(stderr, "Command exceeds %zu bytes.\n", sizeof(command) - 1);
+			return 1;
+		}
+		if (separator) command[used++] = ' ';
+		memcpy(command + used, argv[index], length);
+		used += length;
 	}
 
 	write_fd = open(ORS_INPUT_FILE, O_WRONLY);
