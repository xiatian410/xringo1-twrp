+  const auto directory = std::filesystem::path(digest_filename).parent_path();
+  const android::base::unique_fd dir_fd(TEMP_FAILURE_RETRY(open(
+      directory.empty() ? "." : directory.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC)));
+  if (dir_fd < 0) return failure("directory open");
