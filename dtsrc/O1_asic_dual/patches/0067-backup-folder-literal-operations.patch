+// Backup folder operations use literal names, never shell command text.
+int manage_backup(const std::string& root, const std::string& target,
+                  const std::string& value, bool remove) {
+  twrp_operation_executor::guard transaction(twrp_operation_executor::instance().mutex());
+  operation_start(remove ? "Delete Backup" : "Rename Backup");
+  int status = 1;
+  const std::filesystem::path folder = std::filesystem::path(root).lexically_normal();
+  const std::filesystem::path source = std::filesystem::path(target).lexically_normal();
+  const std::string name = source.filename().string();
+  const bool valid_value = !value.empty() && value != "." && value != ".." &&
+      value.find('/') == std::string::npos && value.find('\0') == std::string::npos;
+  if (!root.empty() && folder.is_absolute() && source.parent_path() == folder &&
+      !name.empty() && name != "." && name != ".." &&
+      target.find('\0') == std::string::npos && root.find('\0') == std::string::npos &&
+      (remove || valid_value)) {
+    const int fd = open(folder.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd >= 0) {
+      struct stat st = {};
+      if (fstatat(fd, name.c_str(), &st, AT_SYMLINK_NOFOLLOW) == 0 && S_ISDIR(st.st_mode)) {
+        if (remove) {
+          // Anchor the parent even if its pathname changes while the worker runs.
+          const std::string path = "/proc/self/fd/" + std::to_string(fd) + "/" + name;
+          status = TWFunc::RemoveDir(path, false) == 0 ? 0 : 1;
+        } else {
+          status = syscall(__NR_renameat2, fd, name.c_str(), fd, value.c_str(),
+                           RENAME_NOREPLACE) == 0 ? 0 : 1;
+        }
+      }
+      close(fd);
+    }
+  }
+  if (status != 0) LOGERR("Backup folder operation failed: '%s'\n", target.c_str());
+  operation_end(status);
+  return status;
 }
 
