 #define SCRIPT_COMMAND_SIZE 512
 
+// Requests are consumed only after the script has closed and its caller has
+// returned. Never reboot from an ORS worker or overwrite an earlier request.
+namespace {
+std::mutex ors_reboot_mutex;
+std::string ors_pending_reboot;
+bool QueueORSReboot(const std::string& target) {
+	std::lock_guard lock(ors_reboot_mutex);
+	if (!ors_pending_reboot.empty()) return false;
+	ors_pending_reboot = target;
+	return true;
+}
+}
+
+bool OpenRecoveryScript::HasPendingReboot() {
+	std::lock_guard lock(ors_reboot_mutex);
+	return !ors_pending_reboot.empty();
+}
+
+bool OpenRecoveryScript::TakePendingReboot(const std::function<bool(const std::string&)>& accept) {
+	std::lock_guard lock(ors_reboot_mutex);
+	if (ors_pending_reboot.empty() || !accept(ors_pending_reboot)) return false;
+	ors_pending_reboot.clear();
+	return true;
+}
