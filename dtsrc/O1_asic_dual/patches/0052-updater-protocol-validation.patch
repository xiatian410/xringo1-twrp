+static bool ParseUpdaterFraction(const char* value, float* result) {
+	if (!value || !*value) return false;
+	char* end = nullptr;
+	errno = 0;
+	const float parsed = strtof(value, &end);
+	if (errno == ERANGE || end == value || *end != '\0' || !std::isfinite(parsed) ||
+		parsed < 0 || parsed > 1) return false;
+	*result = parsed;
+	return true;
+}
+
+static bool ParseUpdaterSeconds(const char* value, int* result) {
+	if (!value || !*value) return false;
+	char* end = nullptr;
+	errno = 0;
+	const long parsed = strtol(value, &end, 10);
+	if (errno == ERANGE || end == value || *end != '\0' || parsed < 0 || parsed > INT_MAX)
+		return false;
+	*result = static_cast<int>(parsed);
+	return true;
+}
