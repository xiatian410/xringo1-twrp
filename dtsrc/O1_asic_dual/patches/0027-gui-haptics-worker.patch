@@ -0,0 +1,49 @@
+#ifndef GUI2_BACKEND_HAPTICS_CONTROLLER_H
+#define GUI2_BACKEND_HAPTICS_CONTROLLER_H
+
+#include <chrono>
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <thread>
+
+namespace gui2_backend {
+
+// Owns GUI haptics I/O. At most one in-flight and one pending request exist;
+// the latest pending request replaces earlier feedback, and expires in 250 ms.
+// None of the caller methods execute probe/play/release or wait for device I/O.
+class haptics_controller {
+ public:
+  haptics_controller(std::function<bool()> probe, std::function<bool(int)> play,
+                     std::function<void()> release);
+  ~haptics_controller();
+  haptics_controller(const haptics_controller&) = delete;
+  haptics_controller& operator=(const haptics_controller&) = delete;
+
+  bool available();  // Cached state; worker refreshes at most every 500 ms.
+  bool submit(int duration_ms);
+  bool consume_error();
+  // Discards queued feedback and joins active I/O before releasing resources.
+  // A kernel call which never returns cannot be cancelled safely here.
+  void stop();
+
+ private:
+  using clock = std::chrono::steady_clock;
+  void run();
+  std::function<bool()> probe_;
+  std::function<bool(int)> play_;
+  std::function<void()> release_;
+  std::mutex mutex_;
+  std::mutex stop_mutex_;
+  std::condition_variable wake_;
+  bool stopping_ = false;
+  bool available_ = false;
+  bool refresh_ = true;
+  bool error_ = false;
+  int pending_ = 0;
+  clock::time_point submitted_;
+  std::thread worker_;
+};
+
+}  // namespace gui2_backend
+#endif
