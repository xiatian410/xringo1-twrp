@@ -0,0 +1,84 @@
+#include "haptics_controller.h"
+
+#include <utility>
+#include <cstdio>
+
+namespace gui2_backend {
+
+haptics_controller::haptics_controller(std::function<bool()> probe,
+                                       std::function<bool(int)> play,
+                                       std::function<void()> release)
+    : probe_(std::move(probe)), play_(std::move(play)), release_(std::move(release)),
+      worker_(&haptics_controller::run, this) {}
+
+haptics_controller::~haptics_controller() { stop(); }
+
+bool haptics_controller::available() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (stopping_) return false;
+  return available_;
+}
+
+bool haptics_controller::submit(int duration_ms) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (stopping_ || !available_ || duration_ms <= 0 || duration_ms > 10000) return false;
+  pending_ = duration_ms;
+  submitted_ = clock::now();
+  wake_.notify_one();
+  return true;
+}
+
+bool haptics_controller::consume_error() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  const bool error = error_;
+  error_ = false;
+  return error;
+}
+
+void haptics_controller::stop() {
+  std::lock_guard<std::mutex> join_lock(stop_mutex_);
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    stopping_ = true;
+    available_ = false;
+    pending_ = 0;
+    wake_.notify_one();
+  }
+  if (worker_.joinable()) worker_.join();
+}
+
+void haptics_controller::run() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  auto next_probe = clock::now();
+  for (;;) {
+    wake_.wait_until(lock, next_probe, [this] { return stopping_ || refresh_ || pending_ > 0; });
+    if (stopping_) break;
+    const int duration = pending_;
+    const bool fresh = clock::now() - submitted_ <= std::chrono::milliseconds(250);
+    pending_ = 0;
+    if (duration > 0 && fresh) {
+      lock.unlock();
+      const bool success = play_(duration);
+      if (!success) std::fprintf(stderr, "GUI2 haptics: background device request failed\n");
+      lock.lock();
+      if (!success) {
+        error_ = true;
+        available_ = false;
+        refresh_ = true;
+      }
+    }
+    if (stopping_) break;
+    if (refresh_ || clock::now() >= next_probe) {
+      refresh_ = false;
+      lock.unlock();
+      const bool ready = probe_();
+      lock.lock();
+      available_ = !stopping_ && ready;
+      next_probe = clock::now() + std::chrono::milliseconds(500);
+    }
+  }
+  lock.unlock();
+  release_();
+}
+
+}  // namespace gui2_backend
