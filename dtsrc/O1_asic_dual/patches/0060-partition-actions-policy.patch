 // GUIAction::wipe; 0 is success.
 int wipe(std::string arg, const std::function<void(const std::string&, int, bool)>& report) {
+  twrp_operation_executor::guard transaction(twrp_operation_executor::instance().mutex());
+  // Validate the entire batch before the first erase, including a list changed
+  // since the page was shown. Internal core/ORS callers retain their own policy.
+  if (arg == "LIST") {
+    const auto list = DataManager::GetStrValue("tw_wipe_list");
+    size_t start = 0;
+    while (start < list.size()) {
+      const auto end = list.find(';', start);
+      if (!wipe_target_allowed(list.substr(start, end == std::string::npos ? end : end - start)))
+        return 1;
+      if (end == std::string::npos) break;
+      start = end + 1;
+    }
+  } else if (!wipe_target_allowed(arg)) {
+    return 1;
+  }
