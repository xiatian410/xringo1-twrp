 // The advanced wipe page: its list writes tw_wipe_list, "path;" per row.
 bool twrp_wipe_backend::start_wipe(const std::vector<std::string>& mount_points) {
+  if (running_.load()) return false;
+  twrp_operation_executor::guard transaction(twrp_operation_executor::instance().mutex());
+  if (mount_points.empty()) return false;
+  for (const auto& path : mount_points) {
+    // One vector entry must never inject a second LIST target.
+    if (path.empty() || path.find(';') != std::string::npos || !wipe_target_allowed(path))
+      return false;
+  }
   std::string list;
   for (const std::string& path : mount_points) list += path + ";";
