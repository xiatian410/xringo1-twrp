+            uint32_t transaction;
+            memcpy(&transaction, data.data() + sizeof(cancellation), sizeof(transaction));
+            // A delayed cancel for a finished command must not abort the next
+            // transfer. The OUT data stage is acknowledged even when idle or
+            // when its transaction differs from the active server command.
+            if (mActiveTransaction.load() != ((uint64_t{1} << 32) | le32toh(transaction)))
