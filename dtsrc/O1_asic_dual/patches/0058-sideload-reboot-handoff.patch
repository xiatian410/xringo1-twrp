+bool twrp_reboot_backend::take_external_reboot() {
+  Device::BuiltinAction action;
+  if (!TakeMiniAdbdRebootAction(&action)) return false;
+  reboot_target target;
+  switch (action) {
+    case Device::REBOOT: target = reboot_target::SYSTEM; break;
+    case Device::REBOOT_BOOTLOADER: target = reboot_target::BOOTLOADER; break;
+    case Device::REBOOT_FASTBOOT: target = reboot_target::FASTBOOT; break;
+    case Device::REBOOT_RECOVERY: target = reboot_target::RECOVERY; break;
+    default: return false;
+  }
+  if (request_reboot(target)) return true;
+  LOGERR("Unable to hand off sideload reboot target\n");
+  return false;
+}
+
 // The fastboot page's switch, on tw_enable_fastboot.
 bool twrp_reboot_backend::usb_fastboot() const {
   return DataManager::GetIntValue("tw_enable_fastboot") != 0;
