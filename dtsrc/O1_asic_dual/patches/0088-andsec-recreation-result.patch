-  }
+    return false;
+  }
+
+  // MountFilesystem cannot bind a directory that was removed by the wipe.
+  // Create it on the mounted filesystem, then explicitly restore the bind.
+  struct stat st {};
+  if (lstat(symlink_path_.c_str(), &st) == 0) {
+    if (!S_ISDIR(st.st_mode)) {
+      gui2_console::log_error("recreate_folder_err", backup_name_);
+      return false;
+    }
+  } else if (errno != ENOENT ||
