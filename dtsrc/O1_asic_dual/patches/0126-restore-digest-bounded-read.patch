+
+// Sidecars contain one checksum line. Bound reads even if a regular file grows
+// after fstat; do not wait for a FIFO writer or read a device as a checksum.
+bool ReadStoredDigest(const int fd, std::string& content) {
+  constexpr size_t kMaxDigestBytes = 64 * 1024;
+  struct stat info{};
+  if (fstat(fd, &info) != 0 || !S_ISREG(info.st_mode) || info.st_size < 0 ||
+      static_cast<uint64_t>(info.st_size) > kMaxDigestBytes) return false;
+  content.clear();
+  std::array<char, 4096> buffer{};
+  for (;;) {
+    const ssize_t count = TEMP_FAILURE_RETRY(read(fd, buffer.data(), buffer.size()));
+    if (count < 0) return false;
+    if (count == 0) return true;
+    if (static_cast<size_t>(count) > kMaxDigestBytes - content.size()) return false;
+    content.append(buffer.data(), static_cast<size_t>(count));
+  }
+}
 
