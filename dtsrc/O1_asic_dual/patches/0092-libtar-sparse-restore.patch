diff --git a/libtar/extract.c b/libtar/extract.c
--- a/libtar/extract.c
+++ b/libtar/extract.c
@@ -238,6 +238,10 @@
 	ssize_t k;
 	int fdout;
 	char buf[T_BLOCKSIZE];
+	static const char zero_block[T_BLOCKSIZE];
+	struct stat output_stat;
+	off_t pending_zeros = 0;
+	int sparse_output;
 	const char *filename;
 	char *pn;
 
@@ -273,6 +277,13 @@
 #endif
 		return -1;
 	}
+	if (fstat(fdout, &output_stat) == -1) {
+		int saved_errno = errno;
+		close(fdout);
+		errno = saved_errno;
+		return -1;
+	}
+	sparse_output = S_ISREG(output_stat.st_mode);
 
 	/* extract the file */
 	for (i = size; i > 0; i -= T_BLOCKSIZE)
@@ -289,21 +300,54 @@
 		/* write block to output file */
 		size_t remaining = (i > T_BLOCKSIZE) ? T_BLOCKSIZE : (size_t)i;
 		char *next = buf;
-		while (remaining > 0) {
-			ssize_t written = write(fdout, next, remaining);
-			if (written < 0 && errno == EINTR)
-				continue;
-			if (written <= 0) {
-				int saved_errno = written == 0 ? EIO : errno;
-				close(fdout);
-				errno = saved_errno;
-				return -1;
+		/* Ordinary tar stores holes as zero bytes. Recreate zero runs only
+		 * on a truncated regular file, without changing the archive format.
+		 * Do not include padding beyond the entry's logical size. */
+		if (sparse_output && memcmp(buf, zero_block, remaining) == 0) {
+			pending_zeros += remaining;
+		} else {
+			if (pending_zeros != 0) {
+				off_t offset;
+				do {
+					offset = lseek(fdout, pending_zeros, SEEK_CUR);
+				} while (offset == (off_t)-1 && errno == EINTR);
+				if (offset == (off_t)-1) {
+					int saved_errno = errno;
+					close(fdout);
+					errno = saved_errno;
+					return -1;
+				}
+				pending_zeros = 0;
 			}
-			next += written;
-			remaining -= written;
+			while (remaining > 0) {
+				ssize_t written = write(fdout, next, remaining);
+				if (written < 0 && errno == EINTR)
+					continue;
+				if (written <= 0) {
+					int saved_errno = written == 0 ? EIO : errno;
+					close(fdout);
+					errno = saved_errno;
+					return -1;
+				}
+				next += written;
+				remaining -= written;
+			}
 		}
 		if (*progress_fd != 0)
 			write(*progress_fd, &progress_size, sizeof(progress_size));
+	}
+	/* Seeking alone does not extend an all-zero file or a trailing hole. */
+	if (pending_zeros != 0) {
+		int result;
+		do {
+			result = ftruncate(fdout, size);
+		} while (result == -1 && errno == EINTR);
+		if (result == -1) {
+			int saved_errno = errno;
+			close(fdout);
+			errno = saved_errno;
+			return -1;
+		}
 	}
 
 	/* close output file */
