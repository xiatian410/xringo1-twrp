 	bool start()
 	{
+		if (started()) return true;
+		// A previous shell still belongs to the reaper. Never overwrite its
+		// ownership or block the GUI waiting for it to leave the kernel.
+		if (reaper.joinable()) {
+			if (!reaped.load()) return false;
+			reaper.join();
+		}
 		fdMaster = getpt();
 		if (fdMaster < 0) {
 			LOGERR("Error %d on getpt()\n", errno);
@@ -81,6 +96,8 @@
 
 		if (unlockpt(fdMaster) != 0) {
 			LOGERR("Error %d on unlockpt()\n", errno);
+			close(fdMaster);
+			fdMaster = -1;
 			return false;
 		}
 
@@ -88,6 +105,7 @@
 		if (pid < 0) {
 			LOGERR("fork failed for pty, error %d\n", errno);
 			close(fdMaster);
+			fdMaster = -1;
 			pid = 0;
 			return false;
 		}
@@ -101,6 +119,7 @@
 		}
 		else {
 			int fdSlave = open(ptsname(fdMaster), O_RDWR);
