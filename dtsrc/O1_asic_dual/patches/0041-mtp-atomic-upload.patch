+
+int TwrpMtpStorage::CreateSendObjectFile(MtpObjectHandle handle, std::string& path) {
+    const std::lock_guard guard(tree_mutex_);
+    auto* entry = FindNode(handle);
+    if (!entry || entry->is_dir || handle != handle_currently_sending_ ||
+        sending_files_.contains(handle)) return -1;
+    std::string temporary = (fs::path(GetNodePath(entry)).parent_path() /
+                             ".mtp-upload-XXXXXX").string();
+    // Creation and registration share the observer lock: no inotify event or
+    // enumeration can expose the partial object between these operations.
+    const int fd = mkstemp(temporary.data());
+    if (fd < 0) return -1;
+    fcntl(fd, F_SETFD, FD_CLOEXEC);
+    sending_files_[handle] = temporary;
+    path = temporary;
+    return fd;
 }
 
