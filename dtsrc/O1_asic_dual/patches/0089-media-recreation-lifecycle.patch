+  // Create only on the mounted parent. Do not continue through a failed mkdir
+  // or treat an existing file/symlink as an internal-storage directory.
+  const auto ensure_directory = [](const std::string& path) {
+    struct stat st {};
+    if (lstat(path.c_str(), &st) == 0) {
+      if (S_ISDIR(st.st_mode)) return true;
+    } else if (errno == ENOENT && mkdir(path.c_str(), 0770) == 0) {
+      // Early boot may have no cached metadata (e.g. a new filesystem).
+      // Preserve that best-effort policy, but make failure visible.
+      if (tw_set_default_metadata(path.c_str()) != 0)
+        LOGINFO("Unable to restore default media metadata: %s\n", path.c_str());
+      return true;
+    }
+    gui2_console::log_error("recreate_folder_err", path);
+    return false;
+  };
+
+  if (!ensure_directory(media_path)) return;
+  const std::string internal_path = DataManager::GetStrValue("tw_internal_path");
+  if (!internal_path.empty() && internal_path != media_path &&
+      !ensure_directory(internal_path)) return;
 #ifdef TW_INTERNAL_STORAGE_PATH
-    mkdir(TW_INTERNAL_STORAGE_PATH, 0770);
+  if (!ensure_directory(TW_INTERNAL_STORAGE_PATH)) return;
 #endif
 
-    // Afterwards, we will try to set the
