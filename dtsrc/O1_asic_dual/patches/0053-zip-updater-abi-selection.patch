+// Dispatch and extraction must agree, including packages with ABI-only updaters.
+static bool FindUpdaterBinary(ZipArchiveHandle Zip, ZipEntry64* entry, std::string* selected_name) {
+	*selected_name = UPDATE_BINARY_NAME;
+	if (FindEntry(Zip, *selected_name, entry) == 0)
+		return true;
+
+	char arches[PATH_MAX];
+	if (property_get("ro.product.cpu.abilist", arches, "") == 0)
+		property_get("ro.product.cpu.abi", arches, "");
+	for (const auto& arch : TWFunc::SplitString(arches, ',', true)) {
+		if (arch.empty()) continue;
+		const std::string name = std::string(UPDATE_BINARY_NAME) + "-" + arch;
+		if (FindEntry(Zip, name, entry) == 0) {
+			*selected_name = name;
+			return true;
+		}
+	}
+	selected_name->clear();
+	return false;
+}
