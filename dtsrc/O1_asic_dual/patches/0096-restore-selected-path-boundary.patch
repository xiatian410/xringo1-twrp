+/* Canonicalize the root once. Entry paths are checked component by component
+ * without following symlinks; '..' is rejected before pathname resolution. */
+int
+tar_set_extract_root(TAR *t, const char *root)
+{
+	char *resolved = realpath(root && *root ? root : ".", NULL);
+	struct stat st;
+	if (!resolved) return -1;
+	if (lstat(resolved, &st) != 0) {
+		int saved = errno; free(resolved); errno = saved; return -1;
+	}
+	if (!S_ISDIR(st.st_mode)) { free(resolved); errno = ENOTDIR; return -1; }
+	free(t->extract_root); t->extract_root = resolved;
+	return 0;
+}
+
+static int
+normalize_extract_path(const char *path, char out[MAXPATHLEN])
+{
+	char absolute[MAXPATHLEN];
+	if (*path == '/') {
+		if (strlen(path) >= sizeof(absolute)) { errno = ENAMETOOLONG; return -1; }
+		strcpy(absolute, path);
+	} else {
+		if (!getcwd(absolute, sizeof(absolute))) return -1;
+		size_t used = strlen(absolute), size = strlen(path);
+		if (used + size + 2 > sizeof(absolute)) { errno = ENAMETOOLONG; return -1; }
+		absolute[used++] = '/'; memcpy(absolute + used, path, size + 1);
+	}
+	size_t used = 0;
+	const char *part = absolute;
+	while (*part) {
+		while (*part == '/') ++part;
+		const char *end = part; while (*end && *end != '/') ++end;
+		size_t size = end - part;
+		if (size == 2 && !memcmp(part, "..", 2)) { errno = EPERM; return -1; }
+		if (size && !(size == 1 && *part == '.')) {
+			out[used++] = '/'; memcpy(out + used, part, size); used += size;
+		}
+		part = end;
+	}
+	if (!used) out[used++] = '/';
+	out[used] = 0;
+	return 0;
+}
+
+int
+tar_guard_extract_path(TAR *t, const char *path, int allow_final_symlink)
+{
+	char normalized[MAXPATHLEN];
+	if (!t->extract_root && tar_set_extract_root(t, ".") != 0) return -1;
+	if (normalize_extract_path(path, normalized) != 0) return -1;
+	size_t root_size = strlen(t->extract_root), size = strlen(normalized);
+	if (strcmp(t->extract_root, "/") &&
+	    (strncmp(normalized, t->extract_root, root_size) ||
+	     (normalized[root_size] && normalized[root_size] != '/'))) {
+		errno = EPERM; return -1;
+	}
+	for (size_t pos = root_size; pos <= size; ++pos) {
+		if (normalized[pos] && normalized[pos] != '/') continue;
+		char saved = normalized[pos]; normalized[pos] = 0;
+		struct stat st;
+		int result = lstat(normalized, &st), error = errno;
+		normalized[pos] = saved;
+		if (result == 0) {
+			if (S_ISLNK(st.st_mode) && !(pos == size && allow_final_symlink)) { errno = ELOOP; return -1; }
+			if (pos != size && !S_ISDIR(st.st_mode)) { errno = ENOTDIR; return -1; }
+		} else if (error == ENOENT) {
+			/* Missing suffix is created by the existing extraction routines. */
+			return 0;
+		} else { errno = error; return -1; }
+	}
+	return 0;
+}
+
+static int
+extract_entry_path(char *out, size_t size, const char *prefix, const char *name)
+{
+	int count = prefix && *prefix ? snprintf(out, size, "%s/%s", prefix, name)
+	                             : snprintf(out, size, "%s", name);
+	if (count < 0 || (size_t)count >= size) { errno = ENAMETOOLONG; return -1; }
+	return 0;
+}
