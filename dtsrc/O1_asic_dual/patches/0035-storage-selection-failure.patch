--- a/gui2/backend/twrp_mount_backend.cpp
+++ b/gui2/backend/twrp_mount_backend.cpp
@@ -221,14 +221,32 @@
     PartitionManager.RefreshPartitionListSnapshots();
   });
   TWPartition* Part = PartitionManager.FindPartitionByPath(path);
-  if (Part == nullptr) {
-    LOGERR("Unable to locate partition for '%s'\n", path.c_str());
+  if (Part == nullptr || !Part->is_storage_ || !Part->is_present_ ||
+      Part->storage_path_ != path) {
+    LOGERR("Storage selection: target unavailable or no longer a storage root: '%s'\n",
+           path.c_str());
     return false;
   }
-  bool update_size = !Part->IsMounted() && Part->removable_;
