+// Each extraction worker owns its records. Finalize only after every volume,
+// worker and codec succeeded, so later child creation cannot change the time.
+int twrpTar::rememberDirectory(void *cookie, const char *path, time_t mtime) {
+	struct stat st{};
+	if (lstat(path, &st) != 0) return -1;
+	if (!S_ISDIR(st.st_mode)) { errno = ENOTDIR; return -1; }
+	auto *archive = static_cast<twrpTar *>(cookie);
+	archive->directory_times.push_back({TWFunc::RemoveTrailingSlashes(path), st.st_dev, st.st_ino, mtime});
+	return 0;
+}
+
+int twrpTar::finishDirectoryTimes() {
+	// Reverse archive order handles the normal parent-before-child traversal.
+	// Times are applied through verified directory descriptors, never a symlink
+	// replacing the recorded directory. Repeated headers keep the last value.
+	std::set<std::pair<dev_t, ino_t>> finished;
+	for (auto it = directory_times.rbegin(); it != directory_times.rend(); ++it) {
+		const int dir = open(it->path.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+		if (dir < 0) return -1;
+		struct stat st{};
+		bool ok = fstat(dir, &st) == 0;
+		if (ok && (st.st_dev != it->device || st.st_ino != it->inode)) {
+			errno = ESTALE;
+			ok = false;
+		}
+		const struct timespec times[2] = {{it->mtime, 0}, {it->mtime, 0}};
+		if (ok && finished.insert({it->device, it->inode}).second && futimens(dir, times) != 0) ok = false;
+		const int saved_errno = errno;
+		if (close(dir) != 0 && ok) return -1;
+		if (!ok) { errno = saved_errno; return -1; }
+	}
+	directory_times.clear();
+	return 0;
+}
