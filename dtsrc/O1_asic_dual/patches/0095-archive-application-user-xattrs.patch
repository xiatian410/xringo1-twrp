+/* Android inode references must be rebuilt by write_path_inode, never copied. */
+int tar_user_xattr_name(const char *name)
+{
+	return !strncmp(name, "user.", 5) && name[5] &&
+	       strcmp(name, "user.default") && strncmp(name, "user.inode_", 11);
+}
+
+void tar_free_user_xattrs(TAR *t)
+{
+	struct tar_user_xattr *item = t->th_buf.user_xattrs;
+	while (item) {
+		struct tar_user_xattr *next = item->next;
+		free(item->name); free(item->value); free(item);
+		item = next;
+	}
+	t->th_buf.user_xattrs = NULL;
+}
+
+int tar_add_user_xattr(TAR *t, const char *name, const void *value, size_t size)
+{
+	size_t bytes = strlen(name) + 1, count = 0;
+	struct tar_user_xattr **slot = &t->th_buf.user_xattrs;
+	if (!tar_user_xattr_name(name) || bytes > 256 || size > 65536 ||
+	    strchr(name, '=') || strchr(name, '\n')) {
+		errno = EINVAL; return -1;
+	}
+	bytes += size;
+	for (struct tar_user_xattr *item = *slot; item; item = item->next) {
+		if (strcmp(item->name, name)) bytes += strlen(item->name) + 1 + item->size;
+		++count;
+	}
+	if (bytes > TAR_XATTR_LIMIT || count >= 1024) { errno = E2BIG; return -1; }
+	struct tar_user_xattr *entry = calloc(1, sizeof(*entry));
+	if (!entry) return -1;
+	entry->name = strdup(name);
+	entry->value = malloc(size ? size : 1);
+	if (!entry->name || !entry->value) {
+		free(entry->name); free(entry->value); free(entry); return -1;
+	}
+	if (size) memcpy(entry->value, value, size);
+	entry->size = size;
+	/* PAX repeated keys use the last record. */
+	while (*slot && strcmp((*slot)->name, name)) slot = &(*slot)->next;
+	if (*slot) {
+		struct tar_user_xattr *old = *slot;
+		entry->next = old->next;
+		free(old->name); free(old->value); free(old);
+	}
+	*slot = entry;
+	return 0;
+}
+
+int tar_collect_user_xattrs(TAR *t, const char *path)
+{
+	char *names = NULL;
+	ssize_t length = -1;
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		ssize_t size = llistxattr(path, NULL, 0);
+		if (size < 0) {
+			if (errno == ENOTSUP) return 0;
+			return -1;
+		}
+		if (size == 0) return 0;
+		if (size > 65536) { errno = E2BIG; return -1; }
+		names = malloc(size);
+		if (!names) return -1;
+		length = llistxattr(path, names, size);
+		if (length >= 0) break;
+		int saved = errno; free(names); names = NULL;
+		if (saved != ERANGE) { errno = saved; return -1; }
+	}
+	if (!names) { errno = EAGAIN; return -1; }
+	for (ssize_t offset = 0; offset < length;) {
+		const char *name = names + offset;
+		size_t size = strnlen(name, length - offset);
+		if (size == 0 || size == (size_t)(length - offset)) { errno = EINVAL; goto fail; }
+		offset += size + 1;
+		if (!tar_user_xattr_name(name)) continue;
+		ssize_t value_size = lgetxattr(path, name, NULL, 0);
+		if (value_size < 0) goto fail;
+		if (value_size > 65536) { errno = E2BIG; goto fail; }
+		void *value = malloc(value_size ? value_size : 1);
+		if (!value) goto fail;
+		ssize_t got = lgetxattr(path, name, value, value_size);
+		if (got != value_size) {
+			int saved = got < 0 ? errno : EAGAIN;
+			free(value); errno = saved; goto fail;
+		}
+		int result = tar_add_user_xattr(t, name, value, value_size);
+		int saved = errno; free(value); errno = saved;
+		if (result != 0) goto fail;
+	}
+	free(names); return 0;
+fail:
+	{ int saved = errno; free(names); errno = saved; return -1; }
+}
