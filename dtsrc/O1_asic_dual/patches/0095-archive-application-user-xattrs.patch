+/* Write one bounded binary PAX header for application xattrs. Legacy metadata
+ * retains its own records; older readers reject unsupported large headers. */
+static size_t
+user_xattr_record_size(const struct tar_user_xattr *item)
+{
+	size_t body = strlen("SCHILY.xattr.") + strlen(item->name) + 1 + item->size;
+	size_t count = body + 3, previous;
+	char number[32];
+	do {
+		previous = count;
+		int digits = snprintf(number, sizeof(number), "%zu", count);
+		count = body + digits + 2;
+	} while (count != previous);
+	return count;
+}
+
+static int
+th_write_user_xattrs(TAR *t)
+{
+	size_t total = 0;
+	for (struct tar_user_xattr *item = t->th_buf.user_xattrs; item; item = item->next) {
+		total += user_xattr_record_size(item);
+		if (total > TAR_XATTR_LIMIT) { errno = E2BIG; return -1; }
+	}
+	if (!total) return 0;
+	size_t blocks = (total + T_BLOCKSIZE - 1) / T_BLOCKSIZE;
+	char *records = calloc(blocks, T_BLOCKSIZE);
+	if (!records) return -1;
+	size_t offset = 0;
+	for (struct tar_user_xattr *item = t->th_buf.user_xattrs; item; item = item->next) {
+		size_t count = user_xattr_record_size(item);
+		int prefix = snprintf(records + offset, blocks * T_BLOCKSIZE - offset,
+		                      "%zu SCHILY.xattr.%s=", count, item->name);
+		if (item->size) memcpy(records + offset + prefix, item->value, item->size);
+		records[offset + count - 1] = '\n'; offset += count;
+	}
+	char old_type = t->th_buf.typeflag;
+	uint64_t old_size = th_get_size(t);
+	t->th_buf.typeflag = TH_EXT_TYPE; th_set_size(t, total); th_finish(t);
+	int result = 0;
+	if (tar_block_write(t, &t->th_buf) != T_BLOCKSIZE) result = -1;
+	for (size_t block = 0; !result && block < blocks; ++block)
+		if (tar_block_write(t, records + block * T_BLOCKSIZE) != T_BLOCKSIZE) result = -1;
+	int saved = errno;
+	t->th_buf.typeflag = old_type; th_set_size(t, old_size);
+	free(records); errno = saved;
+	return result;
 }
 
