+// Opening a FIFO writer without a reader must never stop the GUI thread.
+// Keep one request pending until its reader arrives, then abandon it after a
+// finite handshake window. Do not execute a command whose client disappeared.
+void reset_ors_listener() {
+  pending_command.clear();
+  if (ors_read_fd >= 0) close(ors_read_fd);
+  setup_ors_command();
+}
+
+void dispatch_pending_command() {
+  if (pending_command.empty()) return;
+  if (std::chrono::steady_clock::now() >= pending_deadline) {
+    LOGINFO("CLI output reader did not connect; abandoning request\n");
+    reset_ors_listener();
+    return;
+  }
+  const int output_fd = open(ORS_OUTPUT_FILE, O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+  if (output_fd < 0) {
+    if (errno == ENXIO || errno == EINTR || errno == EAGAIN) return;
+    LOGINFO("Unable to open CLI output: %s\n", strerror(errno));
+    reset_ors_listener();
+    return;
+  }
+  orsout = fdopen(output_fd, "w");
+  if (orsout == nullptr) {
+    close(output_fd);
+    reset_ors_listener();
+    return;
+  }
+  // Preserve nonblocking writes too: a connected client can stop reading.
+  std::string command = std::move(pending_command);
+  pending_command.clear();
+  if (DataManager::GetIntValue("tw_busy") != 0) {
+    fputs("Failed, operation in progress\n", orsout);
+    fclose(orsout);
+    orsout = nullptr;
+    reset_ors_listener();
+  } else if (command == "dumpstrings" || command == "reloadtheme" ||
+             command.starts_with("changepage=")) {
+    fputs("Failed, not supported\n", orsout);
+    fclose(orsout);
+    orsout = nullptr;
+    reset_ors_listener();
+  } else {
+    gui_set_FILE(orsout);
+    OpenRecoveryScript::Call_After_CLI_Command(ors_command_done);
+    if (command_thread.joinable()) command_thread.join();
+    command_active.store(true);
+    command_thread = std::thread(twcmd, std::move(command));
+  }
+}
+
