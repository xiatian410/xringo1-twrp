--- /dev/null
+++ b/sysfs_device_match.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <fnmatch.h>
+#include <string>
+
+namespace twrp_uevent {
+
+// fstab describes a controller (possibly with wildcards); block uevents name
+// descendants of that controller. Match the complete pattern against the node
+// and its ancestors, never just the text before the first wildcard. Like vold,
+// allow '*' to span components. Ancestor boundaries also keep literal paths
+// such as /devices/usb1 from accepting /devices/usb10.
+inline bool MatchesSysfsDevice(const std::string& pattern, std::string path) {
+  if (pattern.empty() || pattern.front() != '/') return false;
+  if (path.starts_with("/sys/")) path.erase(0, 4);
+  if (path.empty() || path.front() != '/') return false;
+  while (path.size() > 1 && path.back() == '/') path.pop_back();
+  for (;;) {
+    if (fnmatch(pattern.c_str(), path.c_str(), 0) == 0) return true;
+    const auto slash = path.rfind('/');
+    if (slash == std::string::npos || slash == 0) return false;
+    path.resize(slash);
+  }
+}
+
+}  // namespace twrp_uevent
