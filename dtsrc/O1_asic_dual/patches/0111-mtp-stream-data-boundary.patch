+int MtpServer::readStreamingData(uint32_t size, MtpOperationCode operation) {
+    const int ret = mData.read(mHandle);
+    if (ret < 0) {
+        if (errno == EPROTO) mProtocolError = true;
+        return ret;
+    }
+    // The 32-bit container length saturates for large/unknown objects. Compute
+    // in 64 bits so payload sizes near UINT32_MAX cannot wrap past the header.
+    const uint32_t expected = std::min<uint64_t>(
+            uint64_t(size) + MTP_CONTAINER_HEADER_SIZE, UINT32_MAX);
+    if (mData.getContainerLength() != expected ||
+        mData.getContainerType() != MTP_CONTAINER_TYPE_DATA ||
+        mData.getContainerCode() != operation ||
+        mData.getTransactionID() != mRequest.getTransactionID() ||
+        static_cast<uint64_t>(ret - MTP_CONTAINER_HEADER_SIZE) > size) {
+        mProtocolError = true;
+        mData.reset();
+        errno = EPROTO;
+        return -1;
+    }
+    return ret;
+}
