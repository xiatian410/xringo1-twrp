+// Recovery has no MediaProvider. Match common advertised formats by the final
+// ASCII extension, as Android's MTP storage manager does via MediaFile. This
+// describes the filename, not validated codec contents or extracted media tags.
+MtpObjectFormat ObjectFormat(const std::string& name, bool directory) {
+    if (directory) return MTP_FORMAT_ASSOCIATION;
+    const auto dot = name.find_last_of('.');
+    if (dot == std::string::npos || dot == 0 || dot + 1 == name.size())
+        return MTP_FORMAT_UNDEFINED;
+    std::string extension = name.substr(dot + 1);
+    for (char& c : extension) {
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+    }
+    static constexpr std::pair<const char*, MtpObjectFormat> formats[] = {
+        {"txt", MTP_FORMAT_TEXT}, {"html", MTP_FORMAT_HTML}, {"htm", MTP_FORMAT_HTML},
+        {"wav", MTP_FORMAT_WAV}, {"mp3", MTP_FORMAT_MP3},
+        {"mpeg", MTP_FORMAT_MPEG}, {"mpg", MTP_FORMAT_MPEG},
+        {"jpg", MTP_FORMAT_EXIF_JPEG}, {"jpeg", MTP_FORMAT_EXIF_JPEG},
+        {"bmp", MTP_FORMAT_BMP}, {"gif", MTP_FORMAT_GIF}, {"jfif", MTP_FORMAT_JFIF},
+        {"png", MTP_FORMAT_PNG}, {"tif", MTP_FORMAT_TIFF}, {"tiff", MTP_FORMAT_TIFF},
+        {"wma", MTP_FORMAT_WMA}, {"ogg", MTP_FORMAT_OGG}, {"aac", MTP_FORMAT_AAC},
+        {"mp4", MTP_FORMAT_MP4_CONTAINER}, {"mp2", MTP_FORMAT_MP2},
+        {"3gp", MTP_FORMAT_3GP_CONTAINER}, {"3gpp", MTP_FORMAT_3GP_CONTAINER},
+        {"wpl", MTP_FORMAT_WPL_PLAYLIST}, {"m3u", MTP_FORMAT_M3U_PLAYLIST},
+        {"pls", MTP_FORMAT_PLS_PLAYLIST}, {"xml", MTP_FORMAT_XML_DOCUMENT},
+        {"flac", MTP_FORMAT_FLAC},
+    };
+    for (const auto& [suffix, format] : formats) {
+        if (extension == suffix) return format;
+    }
+    return MTP_FORMAT_UNDEFINED;
+}
