 using namespace std;
 
 namespace {
+// readdir returns null for both EOF and failure. Clear errno for every call:
+// operations on previous entries may have left an unrelated error behind.
+struct dirent* readDirectory(DIR* directory, int* error) {
+	errno = 0;
+	struct dirent* entry = readdir(directory);
+	if (!entry) *error = errno;
+	return entry;
+}
+
+int closeDirectory(DIR* directory, int error) {
+	if (closedir(directory) != 0 && error == 0) error = errno;
+	if (error != 0) { errno = error; return -1; }
+	return 0;
+}
