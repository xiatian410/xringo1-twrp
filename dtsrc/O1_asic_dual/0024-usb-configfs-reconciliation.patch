diff --git a/etc/init.rc b/etc/init.rc
index 25921ca..8ff678b 100644
--- a/etc/init.rc
+++ b/etc/init.rc
@@ -24,6 +24,7 @@ on early-init
     start ueventd
 
     setprop sys.usb.configfs 0
+    setprop sys.recovery.usb.managed 0
 
 on init
     export PATH /sbin:/system/bin
@@ -192,10 +193,10 @@ on fs
     mkdir /dev/usb-ffs/fastboot 0770 system system
     mount functionfs fastboot /dev/usb-ffs/fastboot rmode=0770,fmode=0660,uid=1000,gid=1000
 
-on property:sys.usb.config=adb
+on property:sys.usb.config=adb && property:sys.recovery.usb.managed=0
     start adbd
 
-on property:sys.usb.config=fastboot
+on property:sys.usb.config=fastboot && property:sys.recovery.usb.managed=0
     start fastbootd
 
 on property:sys.usb.config=none && property:sys.usb.configfs=0
@@ -223,7 +224,7 @@ on property:sys.usb.config=fastboot && property:sys.usb.configfs=0
     setprop sys.usb.state ${sys.usb.config}
 
 # Configfs triggers
-on property:sys.usb.config=none && property:sys.usb.configfs=1
+on property:sys.usb.config=none && property:sys.usb.configfs=1 && property:sys.recovery.usb.managed=0
     write /config/usb_gadget/g1/UDC "none"
     stop adbd
     stop fastbootd
@@ -231,21 +232,21 @@ on property:sys.usb.config=none && property:sys.usb.configfs=1
     rm /config/usb_gadget/g1/configs/b.1/f1
     setprop sys.usb.state ${sys.usb.config}
 
-on property:sys.usb.config=sideload && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
+on property:sys.usb.config=sideload && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1 && property:sys.recovery.usb.managed=0
     write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.adb.pid}
     write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
     symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
     write /config/usb_gadget/g1/UDC ${sys.usb.controller}
     setprop sys.usb.state ${sys.usb.config}
 
-on property:sys.usb.config=adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
+on property:sys.usb.config=adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1 && property:sys.recovery.usb.managed=0
     write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.adb.pid}
     write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
     symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
     write /config/usb_gadget/g1/UDC ${sys.usb.controller}
     setprop sys.usb.state ${sys.usb.config}
 
-on property:sys.usb.config=fastboot && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
+on property:sys.usb.config=fastboot && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1 && property:sys.recovery.usb.managed=0
     write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.fastboot.pid}
     write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "fastboot"
     symlink /config/usb_gadget/g1/functions/ffs.fastboot /config/usb_gadget/g1/configs/b.1/f1
