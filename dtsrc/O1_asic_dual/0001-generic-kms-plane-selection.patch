+/* TWRP: CLO/SDE advertises the pipe role through the "capabilities" blob, but a
+ * generic KMS driver (e.g. xring-drm) has no such property and only publishes
+ * the standard immutable "type" enum. Accept either signal, otherwise no plane
+ * is ever selected and display init fails with "found 0/N primary planes". */
+static bool plane_is_primary(int fd, const Plane& plane) {
+  for (uint32_t j = 0; j < plane.props->count_props; ++j) {
+    const std::string name = plane.props_info[j]->name;
+    const uint64_t value = plane.props->prop_values[j];
+    if (name == "capabilities" && is_primary_plane(fd, value)) return true;
+    if (name == "type" && value == DRM_PLANE_TYPE_PRIMARY) return true;
+  }
+  return false;
+}
