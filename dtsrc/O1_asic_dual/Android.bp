soong_namespace {
}

cc_binary {
    name: "dijun-wait-services",
    recovery: true,
    srcs: ["profiles/runtime/wait_services.cpp"],
    shared_libs: ["libbinder_ndk"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "dijun-usb-config",
    recovery: true,
    srcs: ["profiles/runtime/usb_config.cpp"],
    // The recovery ramdisk does not relabel all shared libraries at boot.
    // Keep this enforcing helper independent of their initial rootfs labels.
    static_executable: true,
    static_libs: ["libbase", "liblog"],
    shared_libs: [],
    cpp_std: "c++20",
    cflags: ["-Wall", "-Wextra", "-Werror"],
}
